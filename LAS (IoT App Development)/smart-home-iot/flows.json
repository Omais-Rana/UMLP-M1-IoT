    {
        "id": "ac_logic_node",
        "type": "function",
        "z": "f6f2187d.f17ca8",
        "name": "Check Temp > 27°C",
        "func": "var temp = msg.payload.temp;\nvar command = \"off\";\n\nif (temp > 27) {\n    command = \"on\";\n}\n\n// Only send if state changes\nvar last = context.get('lastAC') || \"\";\nif (command !== last) {\n    context.set('lastAC', command);\n    msg.payload = command;\n    return msg;\n}\nreturn null;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 400,
        "y": 560,
        "wires": [
            [
                "ac_output_node"
            ]
        ]
    },
