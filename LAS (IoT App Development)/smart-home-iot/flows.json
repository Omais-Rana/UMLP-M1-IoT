        "name": "Check Humidity > 40%",
        "func": "var humid = msg.payload.humidity;\nvar command = \"off\";\n\nif (humid > 40) {\n    command = \"on\";\n}\n\n// Only send if state changes\nvar last = context.get('lastMold') || \"\";\nif (command !== last) {\n    context.set('lastMold', command);\n    msg.payload = command;\n    return msg;\n}\nreturn null;",
