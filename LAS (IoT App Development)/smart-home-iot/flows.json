    {
        "id": "d74a6d05dfe92019",
        "type": "function",
        "z": "f6f2187d.f17ca8",
        "name": "function 2",
        "func": "var parts = msg.topic.split(\"/\");\nvar roomName = parts[1];\n\nvar data = msg.payload;\nif (typeof data === 'string') {\n    data = JSON.parse(data);\n}\n\nmsg.payload = [\n    {  \n        temperature: parseFloat(data.temp),\n        humidity: parseFloat(data.humidity),\n    },\n    {  \n        room: roomName,\n        device: \"esp32\"\n    }\n];\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 320,
        "y": 340,
        "wires": [
