<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <!-- Input for Initial Price -->
    <EditText
        android:id="@+id/InitialPrice"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Initial Price"
        android:inputType="numberDecimal"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:layout_marginTop="100dp"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintWidth_percent="0.7" />

    <!-- Input for Tax -->
    <EditText
        android:id="@+id/Tax"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Tax (%)"
        android:inputType="numberDecimal"
        app:layout_constraintTop_toBottomOf="@+id/InitialPrice"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:layout_marginTop="20dp"
        app:layout_constraintWidth_percent="0.7" />

    <!-- Result field -->
    <EditText
        android:id="@+id/FullPrice"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Full Price"
        android:inputType="numberDecimal"
        android:enabled="false"
        app:layout_constraintTop_toBottomOf="@+id/Tax"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:layout_marginTop="20dp"
        app:layout_constraintWidth_percent="0.7" />

    <!-- Calculate Button -->
    <Button
        android:id="@+id/calculate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Calculate"
        app:layout_constraintTop_toBottomOf="@+id/FullPrice"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:layout_marginTop="30dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
